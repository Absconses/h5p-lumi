   /**
+   * Patch h5p-lumi : vrai si latlng est dans un des polygones du groupe.
+   *
+   * @param {L.LatLng} latlng
+   * @param {L.FeatureGroup} group
+   */
+  GeoQuiz.prototype.isLatLngInLayer = function (latlng, group) {
+    if (!group) {
+      return false;
+    }
+    var x = latlng.lng, y = latlng.lat;
+    // Ramene la longitude dans [-180, 180] (la carte se repete horizontalement)
+    x = ((x + 180) % 360 + 360) % 360 - 180;
+    var inRing = function (ring) {
+      var inside = false;
+      for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
+        var xi = ring[i][0], yi = ring[i][1], xj = ring[j][0], yj = ring[j][1];
+        if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) {
+          inside = !inside;
+        }
+      }
+      return inside;
+    };
+    var inPolygon = function (rings) {
+      if (!inRing(rings[0])) {
+        return false;
+      }
+      for (var k = 1; k < rings.length; k++) {
+        if (inRing(rings[k])) {
+          return false;
+        }
+      }
+      return true;
+    };
+    var found = false;
+    group.eachLayer(function (l) {
+      var g = l.feature && l.feature.geometry;
+      if (!g || found) {
+        return;
+      }
+      if (g.type === 'Polygon') {
+        found = inPolygon(g.coordinates);
+      } else if (g.type === 'MultiPolygon') {
+        for (var m = 0; m < g.coordinates.length && !found; m++) {
+          found = inPolygon(g.coordinates[m]);
+        }
+      }
+    });
+    return found;
+  };
